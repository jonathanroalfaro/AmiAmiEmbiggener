{
    "manifest_version": 3,
    "name": "AmiAmi Embiggener",
    "version": "1.3",
    "description": "Adds several quality of life enhancements to browsing AmiAmi, including sorting your order history.",
    "homepage_url": "https://github.com/software-2/AmiAmiEmbiggener",
    "permissions": ["storage"],
    "host_permissions": ["https://*.amiami.com/*"],
    "content_scripts": [
      {
        "matches": ["https://*.amiami.com/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      },
      {
        "matches": [
          "https://secure.amiami.com/eng",
          "https://secure.amiami.com/eng/*"
        ],
        "js": ["amiami-sorter.js"],
        "css": ["amiami-sorter.css"],
        "run_at": "document_idle"
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "amiami-embiggener@example.com",
        "strict_min_version": "100.0"
      }
    }
  }
